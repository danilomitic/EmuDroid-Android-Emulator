<Window x:Class="EmuDroid.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource HeadingText}" />
            <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
            <TextBox x:Name="Input" Margin="0,16,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,10,0" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
