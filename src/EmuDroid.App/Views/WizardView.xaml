<UserControl x:Class="EmuDroid.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Step list: setup really is a sequence, so the steps are numbered -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="28,36">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="EmuDroid" Style="{StaticResource HeadingText}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="Setup" Style="{StaticResource MutedText}" Margin="0,0,0,36" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Grid Width="28" Height="28">
                                    <Ellipse x:Name="Dot" Stroke="{StaticResource LineBrush}" StrokeThickness="1.5" Fill="Transparent" />
                                    <TextBlock x:Name="Num" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                    <Path x:Name="Tick" Data="M 8,14 L 12,18 L 20,10" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2"
                                          Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="Label" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="14" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="56,48,56,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxWidth="640" HorizontalAlignment="Left">
                <Grid>
                    <!-- Welcome -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVis}, ConverterParameter=Welcome}">
                        <TextBlock Text="Android apps on your PC" Style="{StaticResource TitleText}" FontSize="38" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" FontSize="16" LineHeight="25">
                            EmuDroid runs a real Android phone inside a window, with Google Play, so you can use the same apps and games as on your phone.
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,24,0,0">
                            Setup takes a few minutes. EmuDroid checks your PC, then downloads Android directly from Google (about 2 GB).
                        </TextBlock>
                    </StackPanel>

                    <!-- System check -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVis}, ConverterParameter=SystemCheck}">
                        <TextBlock Text="{Binding CheckTitle}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding CheckMessage}" Style="{StaticResource BodyText}" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" />
                        <ProgressBar IsIndeterminate="True" Margin="0,20,0,0" Width="240" HorizontalAlignment="Left"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="Turn it on" Style="{StaticResource PrimaryButton}" Command="{Binding EnableWhpxCommand}"
                                    Visibility="{Binding CanEnableWhpx, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0" />
                            <Button Content="Restart now" Style="{StaticResource PrimaryButton}" Command="{Binding RestartNowCommand}"
                                    Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0" />
                            <Button Content="Check again" Command="{Binding RunCheckCommand}" />
                        </StackPanel>
                        <Border Style="{StaticResource Panel}" Margin="0,24,0,0"
                                Visibility="{Binding ShowBiosGuide, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BiosGuide}" Style="{StaticResource BodyText}" />
                        </Border>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,24,0,0"
                                   Visibility="{Binding Check.CanRunEmulator, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}">
                            You can continue setup now and fix this later. Android won't start until it's fixed.
                        </TextBlock>
                    </StackPanel>

                    <!-- License -->
                    <DockPanel Visibility="{Binding Step, Converter={StaticResource EnumToVis}, ConverterParameter=License}">
                        <TextBlock DockPanel.Dock="Top" Text="Android SDK License" Style="{StaticResource TitleText}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyText}" Margin="0,12,0,16" Foreground="{StaticResource MutedBrush}">
                            Android and Google Play are made by Google. EmuDroid downloads them straight from Google, so you need to accept Google's license first.
                        </TextBlock>
                        <CheckBox DockPanel.Dock="Bottom" Content="I accept the Android SDK License Agreement" Margin="0,16,0,0"
                                  IsChecked="{Binding LicenseAccepted}" />
                        <Border Style="{StaticResource Panel}" Padding="0" Height="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                                <TextBlock Text="{Binding LicenseText}" Style="{StaticResource MutedText}" FontSize="12" LineHeight="18" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>

                    <!-- Version -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVis}, ConverterParameter=Version}">
                        <TextBlock Text="Choose your Android" Style="{StaticResource TitleText}" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,24" Foreground="{StaticResource MutedBrush}">
                            Android 14 works with almost every app and is the fastest choice. You can add other versions later.
                        </TextBlock>
                        <TextBlock Text="Android version" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Width="320" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Name your first instance" Style="{StaticResource MutedText}" Margin="0,20,0,6" />
                        <TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" MaxLength="40" />
                    </StackPanel>

                    <!-- Download -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVis}, ConverterParameter=Download}">
                        <TextBlock Text="Downloading Android" Style="{StaticResource TitleText}" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,28" Foreground="{StaticResource MutedBrush}">
                            You can keep using your PC. If the download stops, EmuDroid continues from where it was.
                        </TextBlock>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="10" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Cancel download" Command="{Binding CancelDownloadCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Try again" Style="{StaticResource PrimaryButton}" Command="{Binding RetryDownloadCommand}"
                                    Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Done -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EnumToVis}, ConverterParameter=Done}">
                        <TextBlock Text="You're all set" Style="{StaticResource TitleText}" FontSize="38" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" FontSize="16" LineHeight="25">
                            Press Start on your instance. The first start takes a minute or two. Then sign in to Google Play like on a new phone.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Error -->
            <Border Grid.Row="1" Margin="0,20,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource ErrorBrush}"
                    MaxWidth="640" HorizontalAlignment="Left"
                    Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource BodyText}" Foreground="{StaticResource ErrorBrush}" />
            </Border>

            <!-- Navigation -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,28,0,0">
                <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="Welcome"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="Done"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NextCommand}" MinWidth="140">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Continue" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="Welcome"><Setter Property="Content" Value="Get started" /></DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="Version"><Setter Property="Content" Value="Download Android" /></DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="Download"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="Done"><Setter Property="Content" Value="Open EmuDroid" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
