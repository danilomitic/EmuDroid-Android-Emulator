<UserControl x:Class="EmuDroid.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EmuDroid.App.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,28,16,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,32">
                    <!-- Mark: a phone outline with a lit screen -->
                    <Border Width="16" Height="26" CornerRadius="4" BorderThickness="2" BorderBrush="{StaticResource TextBrush}" Margin="0,0,10,0">
                        <Border Margin="2" CornerRadius="1.5" Background="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="EmuDroid" Style="{StaticResource HeadingText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource MutedText}" FontSize="12" Margin="14,0,0,0" />
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Content="Instances" IsChecked="{Binding IsHome}" GroupName="nav" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" IsChecked="{Binding IsSettings}" GroupName="nav" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- Update banner -->
            <Border DockPanel.Dock="Top" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    Padding="28,10" Visibility="{Binding Updates.Available, Converter={StaticResource NotNullToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="What's new" Command="{Binding Updates.ShowNotesCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Skip this version" Command="{Binding Updates.SkipCommand}" Margin="4,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Update now" Command="{Binding Updates.InstallCommand}" Padding="14,6" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}">
                        <Run Text="{Binding Updates.Status, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <Grid>
                <views:HomeView DataContext="{Binding Home}"
                                Visibility="{Binding DataContext.IsHome, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
