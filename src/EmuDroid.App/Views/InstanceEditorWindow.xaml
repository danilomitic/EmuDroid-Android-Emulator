<Window x:Class="EmuDroid.App.Views.InstanceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="28,24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" Margin="0,0,0,20" />

            <TextBlock Text="Name" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" x:Name="NameBox" />

            <TextBlock Text="Android version" Style="{StaticResource MutedText}" Margin="0,16,0,6" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" IsEnabled="{Binding CanChangeVersion}" DisplayMemberPath="Name" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" Text="The Android version can't be changed after the instance is created."
                       Visibility="{Binding CanChangeVersion, Converter={StaticResource InverseBoolToVis}}" />

            <TextBlock Text="Screen" Style="{StaticResource MutedText}" Margin="0,16,0,6" />
            <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding Screen}" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6">
                        <Run Text="Memory: " /><Run Text="{Binding RamGb, Mode=OneWay}" Foreground="{StaticResource TextBrush}" /><Run Text=" GB" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <Slider Minimum="2" Maximum="8" TickFrequency="1" Value="{Binding RamGb}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6">
                        <Run Text="Processor cores: " /><Run Text="{Binding Cores, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <Slider Minimum="1" Maximum="{Binding MaxCores}" TickFrequency="1" Value="{Binding Cores}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Graphics" Style="{StaticResource MutedText}" Margin="0,16,0,6" />
            <ComboBox ItemsSource="{Binding GpuModes}" SelectedItem="{Binding Gpu}" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"
                       Text="Auto is best for most PCs. Use Software only if the screen stays black or flickers." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" Click="OnCancel" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding SaveText}" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
