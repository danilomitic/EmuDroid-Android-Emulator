<Application x:Class="EmuDroid.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EmuDroid.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibility x:Key="BoolToVis" />
            <local:BoolToVisibility x:Key="InverseBoolToVis" Invert="True" />
            <local:NotNullToVisibility x:Key="NotNullToVis" />
            <local:NotNullToVisibility x:Key="NullToVis" Invert="True" />
            <local:StateToBrush x:Key="StateToBrush" />
            <local:EnumEquals x:Key="EnumToVis" />
            <local:AndroidNumber x:Key="AndroidNumber" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
